{
    "name": "expense-tracker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Keep track of income and expenses. Add and remove items and save to local storage",
    "scripts": {
        "db": "json-server --watch db.json --host 0.0.0.0",
        "dev": "vite --port 8080 --host",
        "build": "tsc && vite build",
        "serve": "vite preview --port 8080 --host",
        "test-e2e": "cypress run"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/uuid": "^9.0.0",
        "cypress": "^13.10.0",
        "json-server": "^0.17.1",
        "typescript": "^5.2.2",
        "vite": "^5.3.4",
        "@vitejs/plugin-vue": "^5.0.5",
        "vue-tsc": "^2.0.24"
    },
    "dependencies": {
        "axios": "^1.7.2",
        "uuid": "^9.0.0",
        "vue": "^3.4.31"
    }
}
